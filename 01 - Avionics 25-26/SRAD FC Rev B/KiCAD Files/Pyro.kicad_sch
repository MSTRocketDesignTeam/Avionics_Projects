	(text "PYRO CHANNELS AND SENSE"
		(exclude_from_sim no)
		(at 19.685 66.04 0)
		(effects
			(font
				(size 2.52 2.52)
				(thickness 0.504)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b5bd472b-88f3-4ee3-b0f6-425af2e6a695")
	)
	(text "In case of dead short on one pyro channel, \nan insane amount of current (50A-100A) will\nbe drawn (or attempted). Best case scenario the \nMCU BOR and everything is okay. Worst case scenario\nthe FET fails closed and the entire board / battery\ncatches fire. \n\nThe 15A fuses should fail, preventing the above\nfailures from a shorted pyro channel.  "
		(exclude_from_sim no)
		(at 91.44 154.305 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d9ab4001-52b7-4de4-9807-76ee24d59421")
	)
